# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.sdk-inspection/
.npm-cache-*/
.expo-recovery-clean-export/
.expo-recovery-hermes-export/
.expo-standalone-export/
.local-apk/

# Expo
.expo/
.expo-*-export/
.expo-diary-native-check/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.keystore
*.pfx

# build artifacts
/build/
*.apk
*.aab
*.apks
*.xapk
*.ipa
*.xcarchive/
*.dSYM/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS
.DS_Store
*.pem

# local env files (keep non-secret templates)
.env
.env.*
.env*.local
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

# local credentials and secrets
/.npmrc
credentials.json
credentials.local.json
secrets.json
secrets.*.json
*.secret
*.secrets

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Local Rust toolchain and generated compiler caches
/.local-rust/
/graphics/product-engine/target/
/graphics/skeleton/target/
/graphics/product-engine/.cache/

# Local previews, Android export checks, and the separate Sites checkout
/.local-preview/
/.expo-optimization-android/
/sites/

# Rebuildable art-gallery previews
/scripts/product-art/preview/

# Local design studies and duplicate packaging intermediates
/output/
/assets/product/concepts/
/assets/product/rust/graphics-runtime.unseal-next.html
/graphics/product-engine/preview/

# Claude Code: personal settings and notes stay local
/.claude/settings.local.json
/CLAUDE.local.md

# Android app shell (android-app/): build output and machine paths stay out of the repo.
# Gradle's build folder is redirected outside the repo by scripts/android/build.mjs.
/android-app/.gradle/
/android-app/.kotlin/
/android-app/.idea/
/android-app/build/
/android-app/app/build/
/android-app/local.properties
/android-app/app/src/main/assets/

# iOS app shell (ios-app/): the staged web export, icons and the generated Xcode project.
/ios-app/build/
/ios-app/*.xcodeproj/
/ios-app/DerivedData/
*.ipa
*.aab
*.idsig
